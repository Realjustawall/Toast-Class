ARG APP_IMAGE=toaster-local/app:0.1.0
ARG DOCKER_CLI_IMAGE=docker:29-cli
FROM ${DOCKER_CLI_IMAGE} AS cli
FROM ${APP_IMAGE}
COPY --from=cli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=cli /usr/local/libexec/docker/cli-plugins/docker-compose /usr/local/libexec/docker/cli-plugins/docker-compose
# This dedicated trusted worker alone receives Docker socket access.
# The socket group is supplied by the installation, not baked into the image.
USER node
