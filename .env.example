DATABASE_URL=mysql://toaster:local-development-only@localhost:3306/toaster
APP_ORIGIN=http://localhost:5173
PORT=3001
# Optional: a running local Redis is detected automatically. Set false to disable.
# REDIS_URL=redis://127.0.0.1:6379
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=replace-with-random-secret-at-least-32-characters
NODE_ENV=development
FILE_STORAGE_DRIVER=filesystem
FILE_STORAGE_DIR=.local/storage
FILE_MAX_UPLOAD_BYTES=26214400
# Development only. Production rejects this flag and requires a scanner.
FILE_ALLOW_UNSCANNED=true
# Enable only with the separate Linux worker and converter image configured.
PRESENTATIONS_ENABLED=false
CONVERSION_IMAGE=toaster-converter
# CONVERSION_WORK_DIR=/var/lib/toaster/conversion-jobs
# CLAMAV_HOST=127.0.0.1
# CLAMAV_PORT=3310
# S3_ENDPOINT=http://127.0.0.1:3900
# S3_REGION=garage
# S3_BUCKET=toaster-private
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
